#你一份后端 Deployment 模板，同样支持扩缩容 + 滚动更新，替换镜像即可：
apiVersion: apps/v1
kind: Deployment
metadata:
  name: demo-backend
  namespace: test
  labels:
    app: demo-backend
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: demo-backend
  template:
    metadata:
      labels:
        app: demo-backend
    spec:
      containers:
      - name: backend
        image: my-backend:v1
        ports:
        - containerPort: 8080
        resources:
          requests:
            cpu: 200m
            memory: 256Mi
          limits:
            cpu: 500m
            memory: 512Mi
---
apiVersion: v1
kind: Service
metadata:
  name: demo-backend-svc
  namespace: test
spec:
  type: NodePort
  selector:
    app: demo-backend
  ports:
  - port: 8080
    targetPort: 8080
    nodePort: 30082
